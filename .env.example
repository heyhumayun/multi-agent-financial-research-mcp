# Runtime: local, mcp (in-process compatibility shim), or mcp-stdio (real MCP transport)
FIN_RESEARCH_TOOL_RUNTIME=mcp-stdio

# Live sources are attempted first; deterministic fixtures remain the fallback.
FIN_RESEARCH_LIVE=1
FIN_RESEARCH_OFFLINE_FALLBACK=1
FIN_RESEARCH_MARKET_PROVIDER=auto
FIN_RESEARCH_NEWS_PROVIDER=auto
FIN_RESEARCH_PAPERS_PROVIDER=auto
FIN_RESEARCH_TIMEOUT_SECONDS=8

# Optional free local reasoning. Requires an Ollama process and downloaded model.
FIN_RESEARCH_LLM=off
FIN_RESEARCH_OLLAMA_MODEL=llama3.2:3b

ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=
